# --- secrets: never commit a key ---
.env
*.key
credentials*.json

# --- corpus collecte ---
# Decision d'equipe du 27/11/2026 : les donnees brutes sont versionnees avec
# le code. Chacun retrouve le corpus par un clone, sans archive a s'echanger.
#
# Ce que cela coute : environ 1,3 Go, et un clone aussi lourd pour tout le
# monde. Ce que cela evite : des dossiers vides apres un pull, et des chemins
# qui ne correspondent a rien.
#
# Pour la base francaise, `data/reference/source_registry.yaml` note que la
# licence des donnees brutes ne couvre pas les notices et RCP complets. A
# verifier avant toute diffusion hors de l'equipe.
.cache/

# --- python ---
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
env/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# --- rapport genere, reconstruit par scripts/faire_pdf.py ---
RAPPORT-PHARMEAZOR.html

# --- jupyter ---
.ipynb_checkpoints/
Untitled*.ipynb

